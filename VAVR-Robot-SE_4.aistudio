      }, {
        "text": "\n    if (cpu.data[0x44] \u0026 (1 \u003c\u003c 5)) return cpu.data"
      }, {
        "text": "[0x48]; // TCCR0A \u0026 COM0B1 -\u003e OCR0B\n  } else if"
      }, {
        "text": " (pin \u003d\u003d\u003d 6) {\n    if (cpu.data[0x44] \u0026 (1 \u003c\u003c"
      }, {
        "text": " 7)) return cpu.data[0x47]; // TCCR0A \u0026 COM0A1 -\u003e"
      }, {
        "text": " OCR0A\n  } else if (pin \u003d\u003d\u003d 9) {\n    if (cpu.data"
      }, {
        "text": "[0x80] \u0026 (1 \u003c\u003c 7)) return cpu.data[0x88]; // TCCR"
      }, {
        "text": "1A \u0026 COM1A1 -\u003e OCR1AL\n  } else if (pin \u003d\u003d\u003d 10) {"
      }, {
        "text": "\n    if (cpu.data[0x80] \u0026 (1 \u003c\u003c 5)) return cpu.data"
      }, {
        "text": "[0x8A]; // TCCR1A \u0026 COM1B1 -\u003e OCR1BL\n  } else"
      }, {
        "text": " if (pin \u003d\u003d\u003d 11) {\n    if (cpu.data[0xB0] \u0026 (1"
      }, {
        "text": " \u003c\u003c 7)) return cpu.data[0xB3]; // TCCR2A \u0026 COM2A1 -\u003e"
      }, {
        "text": " OCR2A\n  }\n  // Fallback to digital reading if PWM is not active on the pin"
      }, {
        "text": "\n  return getPinState(cpu, pin) ? 255 : 0;\n};\n\nconst setExternal"
      }, {
        "text": "Pin \u003d (cpu, pin, isHigh) \u003d\u003e {\n  let pinAddr, bit;\n  if ("
      }, {
        "text": "pin \u003e\u003d 0 \u0026\u0026 pin \u003c\u003d 7) { pinAddr \u003d 0x29; bit \u003d pin;"
      }, {
        "text": " }  \n  else if (pin \u003e\u003d 8 \u0026\u0026 pin \u003c\u003d 13) { pinAddr \u003d 0"
