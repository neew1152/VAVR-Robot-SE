      }, {
        "text": ", adcConfig \n} from \u0027avr8js\u0027; \n\nfunction loadHex(source, target) {"
      }, {
        "text": "\n  for (const line of source.split(\u0027\\n\u0027)) {\n    if (line[0] \u003d\u003d\u003d \u0027:\u0027 \u0026\u0026"
      }, {
        "text": " line.substring(7, 9) \u003d\u003d\u003d \u002700\u0027) {\n      const bytes \u003d parseInt(line."
      }, {
        "text": "substring(1, 3), 16);\n      const addr \u003d parseInt(line.substring(3,"
      }, {
        "text": " 7), 16);\n      for (let i \u003d 0; i \u003c bytes; i++) {"
      }, {
        "text": "\n        target[addr + i] \u003d parseInt(line.substring(9 + i * 2, 1"
      }, {
        "text": "1 + i * 2), 16);\n      }\n    }\n  }\n}\n\nconst"
      }, {
        "text": " getPinState \u003d (cpu, pin) \u003d\u003e {\n  let portAddr, bit;\n  if (pin"
      }, {
        "text": " \u003e\u003d 0 \u0026\u0026 pin \u003c\u003d 7) { portAddr \u003d 0x2B; bit \u003d pin; }"
      }, {
        "text": " \n  else if (pin \u003e\u003d 8 \u0026\u0026 pin \u003c\u003d 13) { portAddr \u003d 0x"
      }, {
        "text": "25; bit \u003d pin - 8; } \n  else if (pin \u003e\u003d 14 \u0026\u0026 pin"
      }, {
        "text": " \u003c\u003d 19) { portAddr \u003d 0x28; bit \u003d pin - 14; }"
      }, {
        "text": " \n  else { return false; }\n  return (cpu.data[portAddr] \u0026 (1 \u003c\u003c"
      }, {
        "text": " bit)) !\u003d\u003d 0;\n};\n\nconst setExternalPin \u003d (cpu, pin, isHigh) \u003d\u003e {"
      }, {
        "text": "\n  let pinAddr, bit;\n  if (pin \u003e\u003d 0 \u0026\u0026 pin \u003c\u003d 7) { pin"
      }, {
