      }, {
        "text": "\n    \n    lcd(\"Stopping \u0026 Honking\");\n    ao();\n    beep();\n    sleep(500);"
      }, {
        "text": "\n    \n    lcd(\"Turning Right\");\n    sr(50);\n    sleep(1000);"
      }, {
        "text": "\n  }\n}`;\n\nconst KRUMON_LIB \u003d `\n#include \u003cArduino.h\u003e\n#"
      }, {
        "text": "include \u003cstdarg.h\u003e\n\n#define KRUMON_MOTOR_L 9\n#define KRUM"
      }, {
        "text": "ON_MOTOR_R 10\n#define KRUMON_BUZZER 8\n#define KR"
      }, {
        "text": "UMON_GRABBER 5\n\nvoid _krumon_init() {\n  pinMode(KR"
      }, {
        "text": "UMON_MOTOR_L, OUTPUT);\n  pinMode(KRUMON_MOTOR_R, OUTPUT);"
      }, {
        "text": "\n  pinMode(KRUMON_BUZZER, OUTPUT);\n  pinMode(KRUMON_"
      }, {
        "text": "GRABBER, OUTPUT);\n}\nvoid sleep(int ms) { delay(ms); }\nvoid fd"
      }, {
        "text": "(int p) { digitalWrite(KRUMON_MOTOR_L, HIGH); digitalWrite(KRUMON_MOTOR"
      }, {
        "text": "_R, HIGH); }\nvoid bk(int p) { digitalWrite(KRUMON_MOTOR_L,"
      }, {
