      }, {
        "text": " pin \u003c\u003d 13) { pinAddr \u003d 0x23; bit \u003d pin - 8; }"
      }, {
        "text": " \n  else if (pin \u003e\u003d 14 \u0026\u0026 pin \u003c\u003d 19) { pinAddr \u003d 0"
      }, {
        "text": "x26; bit \u003d pin - 14; } \n  else { return; }\n\n  if"
      }, {
        "text": " (isHigh) {\n    cpu.data[pinAddr] |\u003d (1 \u003c\u003c bit);\n  } else"
      }, {
        "text": " {\n    cpu.data[pinAddr] \u0026\u003d ~(1 \u003c\u003c bit);\n  }\n};\n\nconst generate"
      }, {
        "text": "Id \u003d () \u003d\u003e Math.random().toString(36).substr(2, 9);\n\nconst getOpp"
      }, {
        "text": "ositeColor \u003d (hex) \u003d\u003e {\n  if (hex.indexOf(\u0027#\u0027) \u003d\u003d\u003d 0) hex \u003d hex"
      }, {
        "text": ".slice(1);\n  if (hex.length \u003d\u003d\u003d 3) hex \u003d hex[0]+hex"
      }, {
