        "text": "(\"Releasing...\");\n  keep_down();\n  sleep(500);\n  \n  lcd(\""
      }, {
        "text": "Spinning Right (sr)\");\n  sr(50);\n  sleep(1000);\n}`;"
      }, {
        "text": "\n\nconst KRUMON_LIB \u003d `\n#define Binary_h // Prevent Arduino binary macros (B1,"
      }, {
        "text": " B10, B11) from conflicting with user variables\n#include \u003cArduino.h\u003e\n#include"
      }, {
        "text": " \u003cstdarg.h\u003e\n\n// Secondary safety un-defs just in case something else loaded binary.h\n#"
      }, {
        "text": "undef B1\n#undef B10\n#undef B11\n\n#define KRUMON_MOTOR_"
      }, {
        "text": "L_PWM 9\n#define KRUMON_MOTOR_L_DIR 7\n#define KRUM"
      }, {
        "text": "ON_MOTOR_R_PWM 10\n#define KRUMON_MOTOR_R_DIR 4"
      }, {
        "text": "\n#define KRUMON_BUZZER 8\n#define KRUMON_GRABBER 5"
      }, {
        "text": "\n\nvoid _krumon_init() {\n  pinMode(KRUMON_MOTOR_L_PWM"
      }, {
        "text": ", OUTPUT); pinMode(KRUMON_MOTOR_L_DIR, OUTPUT);\n  pinMode(KRUM"
      }, {
        "text": "ON_MOTOR_R_PWM, OUTPUT); pinMode(KRUMON_MOTOR_R_DIR, OUTPUT);"
      }, {
        "text": "\n  pinMode(KRUMON_BUZZER, OUTPUT);\n  pinMode(KRUMON_"
      }, {
        "text": "GRABBER, OUTPUT);\n}\nvoid sleep(int ms) { delay(ms); }\nvoid fd"
      }, {
        "text": "(int p) { int v\u003d(p*255)/100; digitalWrite(KRUMON_"
      }, {
        "text": "MOTOR_L_DIR, LOW); digitalWrite(KRUMON_MOTOR_R_DIR, LOW); analogWrite"
      }, {
        "text": "(KRUMON_MOTOR_L_PWM, v); analogWrite(KRUMON_MOTOR_R_"
      }, {
        "text": "PWM, v); }\nvoid bk(int p) { int v\u003d(p*255)/10"
      }, {
        "text": "0; digitalWrite(KRUMON_MOTOR_L_DIR, HIGH); digitalWrite(KRUMON_MOTOR_"
      }, {
        "text": "R_DIR, HIGH); analogWrite(KRUMON_MOTOR_L_PWM, v); analogWrite("
      }, {
        "text": "KRUMON_MOTOR_R_PWM, v); }\nvoid sl(int p) { int v\u003d("
      }, {
        "text": "p*255)/100; digitalWrite(KRUMON_MOTOR_L_DIR, HIGH);"
      }, {
        "text": " digitalWrite(KRUMON_MOTOR_R_DIR, LOW); analogWrite(KRUMON_MOTOR_L"
      }, {
        "text": "_PWM, v); analogWrite(KRUMON_MOTOR_R_PWM, v); }\nvoid sr"
      }, {
        "text": "(int p) { int v\u003d(p*255)/100; digitalWrite(KRUMON_"
      }, {
        "text": "MOTOR_L_DIR, LOW); digitalWrite(KRUMON_MOTOR_R_DIR, HIGH); analogWrite"
      }, {
        "text": "(KRUMON_MOTOR_L_PWM, v); analogWrite(KRUMON_MOTOR_R_"
      }, {
        "text": "PWM, v); }\nvoid tl(int p) { int v\u003d(p*255)/10"
      }, {
        "text": "0; digitalWrite(KRUMON_MOTOR_L_DIR, LOW); digitalWrite(KRUMON_MOTOR_"
      }, {
        "text": "R_DIR, LOW); analogWrite(KRUMON_MOTOR_L_PWM, 0); analogWrite"
      }, {
        "text": "(KRUMON_MOTOR_R_PWM, v); }\nvoid tr(int p) { int v"
      }, {
        "text": "\u003d(p*255)/100; digitalWrite(KRUMON_MOTOR_L_DIR, LOW"
      }, {
        "text": "); digitalWrite(KRUMON_MOTOR_R_DIR, LOW); analogWrite(KRUMON_MOTOR_"
      }, {
        "text": "L_PWM, v); analogWrite(KRUMON_MOTOR_R_PWM, 0); }"
      }, {
        "text": "\nvoid ao() { analogWrite(KRUMON_MOTOR_L_PWM, 0); analogWrite(KR"
      }, {
        "text": "UMON_MOTOR_R_PWM, 0); }\nvoid motor(int ch, int p) {"
      }, {
        "text": "\n  int v \u003d abs(p) * 255 / 100;\n  bool dir"
      }, {
        "text": " \u003d p \u003c 0 ? HIGH : LOW;\n  if(ch\u003d\u003d1) { digitalWrite(KRUMON"
      }, {
        "text": "_MOTOR_L_DIR, dir); analogWrite(KRUMON_MOTOR_L_PWM, v);"
      }, {
        "text": " }\n  if(ch\u003d\u003d2) { digitalWrite(KRUMON_MOTOR_R_DIR, dir);"
      }, {
        "text": " analogWrite(KRUMON_MOTOR_R_PWM, v); }\n}\nvoid beep() { digitalWrite"
      }, {
        "text": "(KRUMON_BUZZER, HIGH); delay(100); digitalWrite(KRUMON_BU"
      }, {
        "text": "ZZER, LOW); }\nvoid keylow(char note, int ms) { digitalWrite(KRUMON_"
      }, {
        "text": "BUZZER, HIGH); delay(ms); digitalWrite(KRUMON_BUZZER, LOW); }"
      }, {
        "text": "\nint analog(int ch) { return analogRead(A0 + ch); }\nint sw1() { return"
      }, {
        "text": " 0; }\nvoid sw1_press() {}\nint sw_OK() { return 0; }"
      }, {
        "text": "\nvoid OK() {}\nvoid grab(int state) { digitalWrite(KRUMON_GRABBER, state"
