      }, {
        "text": ", RefreshCcw, FileUp, ImagePlus, Trash2, Wrench, PlusCircle, X, Box }"
      }, {
        "text": " from \u0027lucide-react\u0027;\nimport Matter from \u0027matter-js\u0027;\nimport { \n  CPU,"
      }, {
