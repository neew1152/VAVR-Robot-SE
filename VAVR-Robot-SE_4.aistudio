      }, {
        "text": " } \n  else { return; }\n\n  if (isHigh) {\n    cpu.data"
      }, {
        "text": "[pinAddr] |\u003d (1 \u003c\u003c bit);\n  } else {\n    cpu.data[pinAddr] \u0026\u003d ~("
      }, {
