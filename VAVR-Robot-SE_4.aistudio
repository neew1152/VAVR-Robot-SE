      }, {
        "text": "[] \n};\n\nconst getConfig \u003d () \u003d\u003e {\n  try {\n    const saved \u003d localStorage.getItem(\u0027flawless-config\u0027);\n    if (saved) return { ...DEFAULT_CONFIG, ...JSON.parse(saved) };\n  } catch (e) {}\n  return DEFAULT_CONFIG;\n};\n\nconst defaultCode \u003d `// HARDWARE PINS\nint MOTOR_LEFT \u003d 9;  \nint MOTOR_RIGHT \u003d 10; \nint HORN_PIN \u003d 8;\n\nvoid setup() {\n  Serial.begin(9600);\n  pinMode(MOTOR_LEFT, OUTPUT);\n  pinMode(MOTOR_RIGHT, OUTPUT);\n  pinMode(HORN_PIN, OUTPUT);\n  Serial.println(\"Robot Booted. Ready to drive.\");\n  \n  // TIP: You can print to Virtual Screens by sending [LCD] tag"
      }, {
        "text": "!\n  Serial.println(\"[LCD]System Online\\\\nReady.\");\n  \n  // Beep to signal"
      }, {
        "text": " boot\n  digitalWrite(HORN_PIN, HIGH);\n  delay(200);\n  digital"
      }, {
        "text": "Write(HORN_PIN, LOW);\n}\n\nvoid loop() {\n  Serial.println(\"Driving Forward"
      }, {
        "text": "...\");\n  Serial.println(\"[LCD]Driving Forward\");\n  digitalWrite(MOTOR_LEFT, HIGH);"
      }, {
        "text": "\n  digitalWrite(MOTOR_RIGHT, HIGH);\n  delay(1000);\n\n  Serial.println"
      }, {
        "text": "(\"Stopping \u0026 Honking...\");\n  Serial.println(\"[LCD]Stopped \u0026 Honking\");\n  digitalWrite("
      }, {
        "text": "MOTOR_LEFT, LOW);\n  digitalWrite(MOTOR_RIGHT, LOW);\n  digitalWrite(HORN"
      }, {
        "text": "_PIN, HIGH);\n  delay(500);\n  digitalWrite(HORN_PIN, LOW"
      }, {
        "text": ");\n\n  Serial.println(\"Turning Right...\");\n  Serial.println(\"[LCD]Turning Right...\");\n  digital"
      }, {
        "text": "Write(MOTOR_LEFT, HIGH);\n  digitalWrite(MOTOR_RIGHT, LOW);\n  delay(1"
      }, {
        "text": "000);\n}`;\n\nconst krumonDefaultCode \u003d `// KRUMON V.130"
      }, {
        "text": "715 COMPATIBILITY MODE\n// Functions: fd(), bk(), sl(), sr(), tl(), tr(), ao"
      }, {
        "text": "(), motor(), analog(), beep(), sleep(), lcd(), keep_up(), keep_down()\n\nvoid setup() {"
      }, {
        "text": "\n  int a \u003d 23;\n  float b \u003d 2.34f;"
      }, {
        "text": "\n  \n  // Custom printf natively handles floats!\n  lcd(\" A \u003d %03d \\\\n B \u003d %.2"
      }, {
        "text": "f\", a, b);\n  beep();\n  sleep(1500);\n}"
      }, {
        "text": "\n  \nvoid loop() {\n  lcd(\"Driving Forward\");\n  fd(50);\n  sleep(10"
      }, {
        "text": "00);\n  \n  lcd(\"Turning Left (tl)\");\n  tl(50);\n  sleep(5"
      }, {
        "text": "00);\n  \n  lcd(\"Stopping \u0026 Grabbing\");\n  ao();\n  keep_up();"
      }, {
        "text": "\n  beep();\n  sleep(500);\n  \n  lcd(\"Releasing...\");\n  keep"
      }, {
        "text": "_down();\n  sleep(500);\n  \n  lcd(\"Spinning Right (sr)\");\n  sr(50);"
      }, {
        "text": "\n  sleep(1000);\n}`;\n\nconst KRUMON_LIB \u003d `\n#include \u003c"
      }, {
        "text": "Arduino.h\u003e\n#include \u003cstdarg.h\u003e\n\n#define KRUMON_MOTOR_L"
      }, {
        "text": " 9\n#define KRUMON_MOTOR_R 10\n#define KRUMON_BUZZER"
      }, {
        "text": " 8\n#define KRUMON_GRABBER 5\n\nvoid _krumon_init() {"
      }, {
        "text": "\n  pinMode(KRUMON_MOTOR_L, OUTPUT);\n  pinMode(KRUMON_"
      }, {
        "text": "MOTOR_R, OUTPUT);\n  pinMode(KRUMON_BUZZER, OUTPUT);\n  pin"
      }, {
        "text": "Mode(KRUMON_GRABBER, OUTPUT);\n}\nvoid sleep(int ms) { delay("
      }, {
        "text": "ms); }\nvoid fd(int p) { digitalWrite(KRUMON_MOTOR_L, HIGH); digitalWrite"
      }, {
        "text": "(KRUMON_MOTOR_R, HIGH); }\nvoid bk(int p) { digitalWrite(KRUM"
      }, {
        "text": "ON_MOTOR_L, LOW); digitalWrite(KRUMON_MOTOR_R, LOW); }\nvoid sl"
      }, {
        "text": "(int p) { digitalWrite(KRUMON_MOTOR_L, LOW); digitalWrite(KRUMON_MOTOR"
      }, {
        "text": "_R, HIGH); }\nvoid sr(int p) { digitalWrite(KRUMON_MOTOR_L,"
      }, {
        "text": " HIGH); digitalWrite(KRUMON_MOTOR_R, LOW); }\nvoid tl(int p) { digitalWrite"
      }, {
        "text": "(KRUMON_MOTOR_L, LOW); digitalWrite(KRUMON_MOTOR_R, HIGH); }"
      }, {
        "text": "\nvoid tr(int p) { digitalWrite(KRUMON_MOTOR_L, HIGH); digitalWrite(KRUM"
      }, {
        "text": "ON_MOTOR_R, LOW); }\nvoid ao() { digitalWrite(KRUMON_MOTOR_L,"
      }, {
        "text": " LOW); digitalWrite(KRUMON_MOTOR_R, LOW); }\nvoid motor(int ch, int p"
      }, {
        "text": ") {\n  if(ch\u003d\u003d1) digitalWrite(KRUMON_MOTOR_L, p\u003e0?"
      }, {
        "text": "HIGH:LOW);\n  if(ch\u003d\u003d2) digitalWrite(KRUMON_MOTOR_R, p\u003e"
      }, {
        "text": "0?HIGH:LOW);\n}\nvoid beep() { digitalWrite(KRUMON_BUZZER, HIGH"
      }, {
        "text": "); delay(100); digitalWrite(KRUMON_BUZZER, LOW); }\nvoid keylow"
      }, {
        "text": "(char note, int ms) { digitalWrite(KRUMON_BUZZER, HIGH); delay(ms);"
      }, {
        "text": " digitalWrite(KRUMON_BUZZER, LOW); }\nint analog(int ch) { return analogRead"
      }, {
