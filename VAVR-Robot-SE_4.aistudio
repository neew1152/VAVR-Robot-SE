      }, {
        "text": "\u003d{`bg-gray-50 dark:bg-neutral-800 rounded-lg border border-gray-"
      }, {
        "text": "300 dark:border-neutral-700 p-2 flex flex-col justify-center gap-"
      }, {
        "text": "2 shadow-sm ${displayComponents.length \u003e 0 ? \u0027shrink-0\u0027 : \u0027h-full\u0027"
      }, {
        "text": "}`}\u003e\n              \u003cbutton onClick\u003d{runSimulationCloud} disabled\u003d{isRunning} className\u003d{`flex items-center justify-center"
      }, {
        "text": " gap-2 py-1.5 px-2 rounded font-bold text-[13px] transition-colors"
      }, {
        "text": " ${isRunning ? \u0027bg-gray-300 text-gray-500 dark:bg-gray-"
      }, {
        "text": "700 dark:text-gray-500 cursor-not-allowed\u0027 : \u0027bg-green-"
      }, {
        "text": "600 hover:bg-green-700 text-white\u0027}`}\u003e\n                \u003cPlay size\u003d{1"
      }, {
        "text": "4} fill\u003d\"currentColor\" /\u003e RUN (Cloud)\n              \u003c/button\u003e\n              {offlineHexCode \u0026\u0026 ("
      }, {
        "text": "\n                \u003cbutton onClick\u003d{runSimulationOffline} disabled\u003d{isRunning} className\u003d{`flex items-center justify-center gap"
      }, {
        "text": "-2 py-1.5 px-2 rounded font-bold text-[13px] transition-colors ${"
      }, {
        "text": "isRunning ? \u0027bg-gray-300 text-gray-500 dark:bg-gray-7"
      }, {
        "text": "00 dark:text-gray-500 cursor-not-allowed\u0027 : \u0027bg-blue-6"
      }, {
        "text": "00 hover:bg-blue-700 text-white\u0027}`} title\u003d{`Run ${offlineHexName}`}\u003e"
      }, {
        "text": "\n                  \u003cPlay size\u003d{14} fill\u003d\"currentColor\" /\u003e RUN (Local)\n                \u003c/button\u003e"
      }, {
        "text": "\n              )}\n              \u003cbutton onClick\u003d{stopSimulation} className\u003d\"flex items-center justify-center gap-2 bg"
      }, {
        "text": "-yellow-600 hover:bg-yellow-700 text-white py-1.5 px"
      }, {
        "text": "-2 rounded font-bold text-[13px] transition-colors\"\u003e\n                \u003cSquare size\u003d{14"
      }, {
        "text": "} fill\u003d\"currentColor\" /\u003e STOP\n              \u003c/button\u003e\n              \u003cbutton onClick\u003d{resetSimulation} className\u003d\"flex"
      }, {
        "text": " items-center justify-center gap-2 bg-red-600 hover:bg-red-70"
      }, {
        "text": "0 text-white py-1.5 px-2 rounded font-bold text-[13px] transition-"
      }, {
        "text": "colors\"\u003e\n                \u003cRotateCcw size\u003d{14} /\u003e RESET\n              \u003c/button\u003e\n            \u003c/div\u003e"
      }, {
        "text": "\n          \u003c/div\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n  );\n}\n\nexport default App;\n```"
