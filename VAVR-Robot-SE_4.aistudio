      }, {
        "text": "[linear-gradient(rgba(14,165,233,0.1)_1px,transparent_1px),linear-gradient(90deg,rgba(14,165,233,0.1)_1px,transparent_1px)] bg-"
      }, {
        "text": "[size:2px_2px]\"\u003e\u003c/div\u003e\n                            \u003cdiv className\u003d\"text-cyan-400 font-mono font-"
      }, {
        "text": "bold text-center z-10 text-[10px] tracking-wide shadow-cyan-500"
      }, {
