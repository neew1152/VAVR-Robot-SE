      }, {
        "text": "rumon_init() {\n  pinMode(KRUMON_MOTOR_L, OUTPUT);\n  pin"
      }, {
        "text": "Mode(KRUMON_MOTOR_R, OUTPUT);\n  pinMode(KRUMON_BUZZER"
      }, {
