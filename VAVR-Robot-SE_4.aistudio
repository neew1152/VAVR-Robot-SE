      }, {
        "text": "\n  ao();\n  keep_up();\n  beep();\n  sleep(500);\n  \n  lcd(\"Releasing...\");"
      }, {
        "text": "\n  keep_down();\n  sleep(500);\n  \n  lcd(\"Turning Right\");"
      }, {
        "text": "\n  sr(50);\n  sleep(1000);\n}`;\n\nconst KRUMON_LIB"
      }, {
        "text": " \u003d `\n#include \u003cArduino.h\u003e\n#include \u003cstdarg.h\u003e\n\n#define KRUM"
      }, {
        "text": "ON_MOTOR_L 9\n#define KRUMON_MOTOR_R 10\n#define KR"
      }, {
