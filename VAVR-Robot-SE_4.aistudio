      }, {
        "text": "[linear-gradient(rgba(14,165,233,0.1)_1px,transparent_1px),linear-gradient(90deg,rgba(14,165,233,0.1)_1px,transparent_1px)] bg-[size:2px_2px]\"\u003e"
      }, {
        "text": "\u003c/div\u003e\n                            \u003cdiv data-screen-type\u003d\"oled128x64\" className\u003d\"screen-text"
      }, {
        "text": "-content text-cyan-400 font-mono font-bold text-center z-10 text-"
      }, {
