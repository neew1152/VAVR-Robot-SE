        "text": "[] \n};\n\nconst getConfig \u003d () \u003d\u003e {\n  try {\n    const saved \u003d localStorage.getItem(\u0027flawless-config\u0027);\n    if (saved) return { ...DEFAULT_CONFIG, ...JSON.parse(saved) };\n  } catch (e) {}\n  return DEFAULT_CONFIG;\n};\n\nconst defaultCode \u003d `// HARDWARE PINS\nint MOTOR_LEFT \u003d 9;  \nint MOTOR_RIGHT \u003d 10; \nint HORN_PIN \u003d 8;\n\nvoid setup() {\n  Serial.begin(9600);\n  pinMode(MOTOR_LEFT, OUTPUT);\n  pinMode(MOTOR_RIGHT, OUTPUT);\n  pinMode(HORN_PIN, OUTPUT);\n  Serial.println(\"Robot Booted. Ready to drive.\");\n  \n  // Beep to signal boot\n  digitalWrite(HORN_PIN, HIGH);\n  delay(200);\n  digitalWrite(HORN_PIN, LOW);\n}\n\nvoid loop() {\n  Serial.println(\"Driving Forward...\");\n  digitalWrite(MOTOR_LEFT, HIGH);\n  digitalWrite(MOTOR_RIGHT, HIGH);\n  delay(1000);\n\n  Serial.println(\"Stopping \u0026 Honking...\");\n  digitalWrite(MOTOR_LEFT, LOW);\n  digitalWrite(MOTOR_RIGHT, LOW);\n  digitalWrite(HORN_PIN, HIGH);\n  delay(500);\n  digitalWrite(HORN_PIN, LOW);\n\n  Serial.println(\"Turning Right...\");\n  digitalWrite(MOTOR_LEFT, HIGH);\n  digitalWrite(MOTOR_RIGHT, LOW);\n  delay(1000);\n}`;\n\nconst getSavedCode \u003d () \u003d\u003e {\n  try {\n    const saved \u003d localStorage.getItem(\u0027flawless-code-cache\u0027);\n    if (saved !\u003d\u003d null) return saved;\n  } catch (e) {}\n  return defaultCode;\n};\n\nfunction App() {\n  const initConfig \u003d getConfig();\n  \n  const"
