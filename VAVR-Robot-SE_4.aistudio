        "text": "(500);\n}`;\n\nconst krumonDefaultCode \u003d `// KRUMON V.13"
      }, {
        "text": "0715 COMPATIBILITY MODE\n// Functions: fd(), bk(), sl(), sr(), tl(), tr(),"
      }, {
        "text": " ao(), motor(), analog(), beep(), sleep(), lcd(), keep_up(), keep_down()\n\nvoid setup()"
      }, {
        "text": " {\n  int a \u003d 23;\n  float b \u003d 2.34f;"
      }, {
        "text": "\n  \n  // Custom printf natively handles floats!\n  lcd(\" A \u003d %03d \\\\n B \u003d %."
      }, {
        "text": "2f\", a, b);\n  beep();\n  sleep(1500);\n}"
      }, {
        "text": "\n  \nvoid loop() {\n  lcd(\"Driving Forward (50%)\");\n  fd(50);"
      }, {
        "text": "\n  sleep(1000);\n  \n  lcd(\"Turning Left (tl)\");\n  tl(5"
      }, {
        "text": "0);\n  sleep(500);\n  \n  lcd(\"Stopping \u0026 Grabbing\");\n  ao"
