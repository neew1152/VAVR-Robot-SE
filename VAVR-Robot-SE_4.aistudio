      }, {
        "text": "); }\nvoid keep_down() { digitalWrite(KRUMON_GRABBER, LOW); }\nvoid"
      }, {
        "text": " system_stop() { ao(); while(1); }\n\nvoid lcd(const char* format, ...) {"
      }, {
        "text": "\n  va_list args;\n  va_start(args, format);\n  Serial.print(\"[LCD]\");"
      }, {
        "text": "\n  while (*format !\u003d \u0027\\\\0\u0027) {\n    if (*format \u003d\u003d \u0027%\u0027) {\n      format++;"
      }, {
        "text": "\n      bool zeroPad \u003d false;\n      int width \u003d 0;\n      if (*format \u003d\u003d \u00270\u0027)"
      }, {
        "text": " {\n        zeroPad \u003d true;\n        format++;\n      }\n      while (*format \u003e\u003d \u00270\u0027"
      }, {
        "text": " \u0026\u0026 *format \u003c\u003d \u00279\u0027) {\n        width \u003d width * 10 + (*format - \u00270\u0027);"
      }, {
        "text": "\n        format++;\n      }\n      int decimals \u003d 2;\n      if (*format \u003d\u003d \u0027.\u0027) {"
      }, {
        "text": "\n        format++;\n        decimals \u003d 0;\n        while (*format \u003e\u003d \u00270\u0027 \u0026\u0026 *format \u003c\u003d \u0027"
      }, {
        "text": "9\u0027) {\n          decimals \u003d decimals * 10 + (*format - \u00270\u0027);\n          format++;"
      }, {
        "text": "\n        }\n      }\n      if (*format \u003d\u003d \u0027d\u0027 || *format \u003d\u003d \u0027i\u0027 || *format"
      }, {
        "text": " \u003d\u003d \u0027u\u0027) {\n        String s \u003d String(va_arg(args, int));\n        while("
      }, {
        "text": "s.length() \u003c width) s \u003d (zeroPad ? \"0\" : \" \") + s;"
      }, {
        "text": "\n        Serial.print(s);\n      } else if (*format \u003d\u003d \u0027l\u0027) { \n        format++;"
      }, {
        "text": "\n        if (*format \u003d\u003d \u0027d\u0027 || *format \u003d\u003d \u0027i\u0027 || *format \u003d\u003d \u0027u\u0027) {"
      }, {
        "text": "\n          String s \u003d String(va_arg(args, long));\n          while(s.length() \u003c width"
      }, {
        "text": ") s \u003d (zeroPad ? \"0\" : \" \") + s;\n          Serial.print(s);"
      }, {
        "text": "\n        }\n      } else if (*format \u003d\u003d \u0027f\u0027) {\n        double val \u003d va_arg("
      }, {
        "text": "args, double);\n        char buf[32];\n        dtostrf(val, width \u003e 0"
      }, {
        "text": " ? width : 1, decimals, buf);\n        String s \u003d String(buf);\n        if (zero"
      }, {
        "text": "Pad) {\n            s.trim();\n            while(s.length() \u003c width) s \u003d \"0"
      }, {
        "text": "\" + s;\n        }\n        Serial.print(s);\n      } else if (*format \u003d\u003d \u0027"
      }, {
        "text": "s\u0027) {\n        Serial.print(va_arg(args, char*));\n      } else if (*"
      }, {
        "text": "format \u003d\u003d \u0027c\u0027) {\n        Serial.print((char)va_arg(args, int));"
      }, {
        "text": "\n      } else if (*format \u003d\u003d \u0027%\u0027) {\n        Serial.print(\u0027%\u0027);\n      } else {\n        Serial"
      }, {
        "text": ".print(\u0027%\u0027);\n        Serial.print(*format);\n      }\n    } else if (*format \u003d\u003d \u0027\\\\"
      }, {
        "text": "n\u0027) {\n      Serial.print(\"\\\\\\\\n\");\n    } else {\n      Serial.print(*format"
      }, {
        "text": ");\n    }\n    format++;\n  }\n  Serial.println();\n  va_end(args"
      }, {
        "text": ");\n}\n`;\n\nconst getSavedCode \u003d () \u003d\u003e {\n  try {\n    const saved \u003d localStorage"
