        "text": "[] \n};\n\nconst getConfig \u003d () \u003d\u003e {\n  try {\n    const saved \u003d localStorage.getItem(\u0027flawless-config\u0027);\n    if (saved) return { ...DEFAULT_CONFIG, ...JSON.parse(saved) };\n  } catch (e) {}\n  return DEFAULT_CONFIG;\n};\n\nconst defaultCode \u003d `// HARDWARE PINS\nint MOTOR_LEFT \u003d 9;  \nint MOTOR_RIGHT \u003d 10; \nint HORN_PIN \u003d 8;\n\nvoid setup() {\n  Serial.begin(9600);\n  pinMode(MOTOR_LEFT, OUTPUT);\n  pinMode(MOTOR_RIGHT, OUTPUT);\n  pinMode(HORN_PIN, OUTPUT);\n  Serial.println(\"Robot Booted. Ready to drive.\");\n  \n  // Beep to signal boot\n  digitalWrite(HORN_PIN, HIGH);\n  delay(200);\n  digitalWrite(HORN_PIN, LOW);\n}\n\nvoid loop() {\n  Serial.println(\"Driving Forward...\");\n  digitalWrite(MOTOR_LEFT, HIGH);\n  digitalWrite(MOTOR_RIGHT, HIGH);\n  delay(1000);\n\n  Serial.println(\"Stopping \u0026 Honking...\");\n  digitalWrite(MOTOR_LEFT, LOW);\n  digitalWrite(MOTOR_RIGHT, LOW);\n  digitalWrite(HORN_PIN, HIGH);\n  delay(500);\n  digitalWrite(HORN_PIN, LOW);\n\n  Serial.println(\"Turning Right...\");\n  digitalWrite(MOTOR_LEFT, HIGH);\n  digitalWrite(MOTOR_RIGHT, LOW);\n  delay(1000);\n}`;\n\nconst krumonDefaultCode \u003d `// KRUMON V.130715 COMPATIBILITY MODE\n// Functions: fd(), bk(), sl(), sr(), ao(), motor(), analog(), beep(), sleep(), lcd()\n\nvoid main() {\n  lcd(\"Krumon Booted\");\n  beep();\n  sleep(200);\n  \n  while(1) {\n    lcd(\"Driving Forward\");\n    fd(50);\n    sleep(1000);\n    \n    lcd(\"Stopping \u0026 Honking\");\n    ao();\n    beep();\n    sleep(500);\n    \n    lcd(\"Turning Right\");\n    sr(50);\n    sleep(1000);\n  }\n}`;\n\nconst KRUMON_LIB \u003d `\n#include \u003cArduino.h\u003e\n#include \u003cstdarg.h\u003e\n\n#define KRUMON_MOTOR_L 9\n#define KRUMON_MOTOR_R 10\n#define KRUMON_BUZZER 8\n#define KRUMON_GRABBER 5\n\nvoid _krumon_init() {\n  pinMode(KRUMON_MOTOR_L, OUTPUT);\n  pinMode(KRUMON_MOTOR_R, OUTPUT);\n  pinMode(KRUMON_BUZZER, OUTPUT);\n  pinMode(KRUMON_GRABBER, OUTPUT);\n}\nvoid sleep(int ms) { delay(ms); }\nvoid fd(int p) { digitalWrite(KRUMON_MOTOR_L, HIGH); digitalWrite(KRUMON_MOTOR_R, HIGH); }\nvoid bk(int p) { digitalWrite(KRUMON_MOTOR_L, LOW); digitalWrite(KRUMON_MOTOR_R, LOW); }\nvoid sl(int p) { digitalWrite(KRUMON_MOTOR_L, LOW); digitalWrite(KRUMON_MOTOR_R, HIGH); }\nvoid sr(int p) { digitalWrite(KRUMON_MOTOR_L, HIGH); digitalWrite(KRUMON_MOTOR_R, LOW); }\nvoid ao() { digitalWrite(KRUMON_MOTOR_L, LOW); digitalWrite(KRUMON_MOTOR_R, LOW); }\nvoid motor(int ch, int p) {\n  if(ch\u003d\u003d1) digitalWrite(KRUMON_MOTOR_L, p\u003e0?HIGH:LOW);\n  if(ch\u003d\u003d2) digitalWrite(KRUMON_MOTOR_R, p\u003e0?HIGH:LOW);\n}\nvoid beep() { digitalWrite(KRUMON_BUZZER, HIGH); delay(100); digitalWrite(KRUMON_BUZZER, LOW); }\nvoid keylow(char note, int ms) { digitalWrite(KRUMON_BUZZER, HIGH); delay(ms); digitalWrite(KRUMON_BUZZER, LOW); }\nint analog(int ch) { return analogRead(A0 + ch); }\nint sw1() { return 0; }\nvoid sw1_press() {}\nint sw_OK() { return 0; }\nvoid OK() {}\nvoid grab(int state) { digitalWrite(KRUMON_GRABBER, state ? HIGH : LOW); }\nvoid lcd(const char* format, ...) {\n  char buf[64]; va_list args; va_start(args, format); vsn"
      }, {
        "text": "printf(buf, sizeof(buf), format, args); va_end(args);\n  Serial.print(\""
      }, {
        "text": "[LCD] \"); Serial.println(buf);\n}\n`;\n\nconst getSavedCode \u003d () \u003d\u003e {"
