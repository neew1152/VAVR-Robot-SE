      }, {
        "text": " LOW);\n  delay(1000);\n}`;\n\nconst krumonDefaultCode \u003d `// KR"
      }, {
        "text": "UMON V.130715 COMPATIBILITY MODE\n// Functions: fd(), bk(), sl(),"
      }, {
        "text": " sr(), ao(), motor(), analog(), beep(), sleep(), lcd(), keep_up(), keep_down()\n\nvoid"
      }, {
        "text": " setup() {\n  lcd(\"Krumon Booted\\\\nReady to Drive\");\n  beep();"
      }, {
        "text": "\n  sleep(200);\n}\n  \nvoid loop() {\n  lcd(\"Driving Forward\");\n  fd"
      }, {
