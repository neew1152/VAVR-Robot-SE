        "text": "() { ao(); while(1); }\n\nvoid lcd(const char* format, ...) {\n  va_"
      }, {
        "text": "list args;\n  va_start(args, format);\n  Serial.print(\"[LCD]\");\n  while"
      }, {
        "text": " (*format !\u003d \u0027\\\\0\u0027) {\n    if (*format \u003d\u003d \u0027%\u0027) {\n      format++;\n      bool zero"
      }, {
        "text": "Pad \u003d false;\n      int width \u003d 0;\n      if (*format \u003d\u003d \u00270\u0027) {"
      }, {
        "text": "\n        zeroPad \u003d true;\n        format++;\n      }\n      while (*format \u003e\u003d \u00270\u0027 \u0026\u0026 *format"
      }, {
