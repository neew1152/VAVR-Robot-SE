      }, {
        "text": " \n  AVRUSART, usart0Config,\n  AVRADC, adcConfig \n} from \u0027"
      }, {
        "text": "avr8js\u0027; \n\nfunction loadHex(source, target) {\n  for (const line of source."
      }, {
        "text": "split(\u0027\\n\u0027)) {\n    if (line[0] \u003d\u003d\u003d \u0027:\u0027 \u0026\u0026 line.substring(7, 9"
