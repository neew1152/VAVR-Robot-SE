      }, {
        "text": ") \u003d\u003d\u003d \u002700\u0027) {\n      const bytes \u003d parseInt(line.substring(1, 3),"
      }, {
        "text": " 16);\n      const addr \u003d parseInt(line.substring(3, 7), 16);"
      }, {
        "text": "\n      for (let i \u003d 0; i \u003c bytes; i++) {\n        target[addr + i]"
      }, {
        "text": " \u003d parseInt(line.substring(9 + i * 2, 11 + i * 2),"
      }, {
        "text": " 16);\n      }\n    }\n  }\n}\n\nconst getPinState \u003d (cpu, pin"
      }, {
        "text": ") \u003d\u003e {\n  let portAddr, bit;\n  if (pin \u003e\u003d 0 \u0026\u0026 pin \u003c\u003d 7"
      }, {
        "text": ") { portAddr \u003d 0x2B; bit \u003d pin; } \n  else if (pin \u003e\u003d"
      }, {
        "text": " 8 \u0026\u0026 pin \u003c\u003d 13) { portAddr \u003d 0x25; bit \u003d pin -"
      }, {
        "text": " 8; } \n  else if (pin \u003e\u003d 14 \u0026\u0026 pin \u003c\u003d 19) { portAddr"
      }, {
        "text": " \u003d 0x28; bit \u003d pin - 14; } \n  else { return false;"
      }, {
        "text": " }\n  return (cpu.data[portAddr] \u0026 (1 \u003c\u003c bit)) !\u003d\u003d 0;\n};"
      }, {
        "text": "\n\n// Directly read the ATmega328P Timer Output Compare Registers (OCR) for precise Analog/PWM values"
      }, {
        "text": "\nconst getPinPWM \u003d (cpu, pin) \u003d\u003e {\n  if (pin \u003d\u003d\u003d 3) {"
      }, {
        "text": "\n    if (cpu.data[0xB0] \u0026 (1 \u003c\u003c 5)) return cpu.data"
      }, {
