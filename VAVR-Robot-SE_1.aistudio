        "text": " \u003d 0; i \u003c bytes; i++) {\n        target[addr + i] \u003d parseInt(line."
      }, {
        "text": "substring(9 + i * 2, 11 + i * 2), 16);"
      }, {
        "text": "\n      }\n    }\n  }\n}\n\nfunction App() {\n  const[code, setCode] \u003d"
      }, {
        "text": " useState(`void setup() {\\n  Serial.begin(9600);\\n  Serial.println(\"Hello"
      }, {
        "text": " from Flawless Simulator!\");\\n}\\n\\nvoid loop() {\\n  Serial.println(\"Running perfectly"
      }, {
        "text": "...\");\\n  delay(1000);\\n}`);\n  \n  // UI States\n  const"
      }, {
        "text": "[sysLogs, setSysLogs] \u003d useState([\u0027\u003e System Ready. Waiting for compilation...\u0027]);\n  const"
      }, {
        "text": "[serialOutput, setSerialOutput] \u003d useState(\"\");\n  const [isRunning, setIsRunning] \u003d useState(false);"
      }, {
        "text": "\n  \n  const requestRef \u003d useRef(null);\n  const logEndRef \u003d useRef(null);\n\n  // Auto-scroll"
      }, {
        "text": " terminal\n  useEffect(() \u003d\u003e {\n    logEndRef.current?.scrollIntoView({ behavior: \"smooth\" });"
      }, {
        "text": "\n  }, [sysLogs, serialOutput]);\n\n  const stopSimulation \u003d () \u003d\u003e {\n    if (requestRef.current) {"
      }, {
        "text": "\n      cancelAnimationFrame(requestRef.current);\n      requestRef.current \u003d null;\n    }"
      }, {
        "text": "\n    setIsRunning(false);\n    setSysLogs(prev \u003d\u003e [...prev, \u0027\u003e Simulation STOPPED.\u0027]);\n  };"
      }, {
        "text": "\n\n  const resetSimulation \u003d () \u003d\u003e {\n    stopSimulation();\n    setSerialOutput(\"\");\n    setSysLogs("
      }, {
        "text": "[\u0027\u003e System Reset. Memory flushed. Ready.\u0027]);\n  };\n\n  const runSimulation \u003d async () \u003d\u003e {\n    if (isRunning"
      }, {
        "text": ") return;\n    setSysLogs([\u0027\u003e Compiling code via Cloud Compiler...\u0027]);\n    setSerialOutput(\"\"); //"
      }, {
        "text": " Clear old serial data\n    \n    try {\n      const response \u003d await fetch(\u0027https://hexi.wokwi.com"
      }, {
        "text": "/build\u0027, {\n        method: \u0027POST\u0027,\n        headers: { \u0027Content-Type\u0027: \u0027application/"
      }, {
        "text": "json\u0027 },\n        body: JSON.stringify({ sketch: code })\n      });\n      const data \u003d await"
      }, {
        "text": " response.json();\n      \n      if (!data.hex) {\n        setSysLogs(prev \u003d\u003e"
      }, {
        "text": "[...prev, \u0027\u003e COMPILATION FAILED:\u0027, data.stderr || data.compilerErrors]);\n        return;\n      }"
      }, {
        "text": "\n      \n      setSysLogs(prev \u003d\u003e [...prev, \u0027\u003e Compilation Success! Flashing to Virtual Flash Memory...\u0027]);"
      }, {
        "text": "\n      \n      const program \u003d new Uint16Array(16384);\n      loadHex("
      }, {
        "text": "data.hex, new Uint8Array(program.buffer));\n      \n      const cpu \u003d new CPU(program"
      }, {
        "text": ");\n      \n      // FULL HARDWARE INSTANTIATION (No more boot loops!)\n      const timer0 \u003d new AVR"
      }, {
        "text": "Timer(cpu, timer0Config);\n      const timer1 \u003d new AVRTimer(cpu, timer1Config);"
      }, {
        "text": "\n      const timer2 \u003d new AVRTimer(cpu, timer2Config);\n      const portB \u003d new AV"
      }, {
        "text": "RIOPort(cpu, portBConfig);\n      const portC \u003d new AVRIOPort(cpu,"
      }, {
        "text": " portCConfig);\n      const portD \u003d new AVRIOPort(cpu, portDConfig);"
      }, {
        "text": "\n      const usart \u003d new AVRUSART(cpu, usart0Config, 16e6);"
      }, {
        "text": "\n      \n      // Real-time Serial Output Mapping\n      usart.onByteTransmit \u003d (byte) \u003d\u003e {\n        const char"
      }, {
        "text": " \u003d String.fromCharCode(byte);\n        setSerialOutput(prev \u003d\u003e prev + char);\n      };"
      }, {
        "text": "\n      \n      setIsRunning(true);\n      setSysLogs(prev \u003d\u003e"
      }, {
        "text": "[...prev, \u0027\u003e Virtual Arduino RUNNING...\u0027]);\n      \n      const executeFrame \u003d () \u003d\u003e {\n         try {\n            // Run exactly 1 frame"
