      }, {
        "text": ");\n\n  Serial.println(\"Turning Right...\");\n  digitalWrite(MOTOR_LEFT, HIGH);\n  digital"
      }, {
        "text": "Write(MOTOR_RIGHT, LOW);\n  delay(1000);\n}`;\n\nfunction App() {"
      }, {
        "text": "\n  const initConfig \u003d getConfig();\n  \n  const[code, setCode] \u003d useState(defaultCode);"
