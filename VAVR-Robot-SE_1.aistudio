      }, {
        "text": "div className\u003d\"flex-grow\"\u003e\n            \u003cEditor\n              height\u003d\"100%\"\n              defaultLanguage\u003d\""
      }, {
        "text": "cpp\"\n              theme\u003d\"vs-dark\"\n              value\u003d{code}\n              onChange\u003d{(value) \u003d\u003e set"
      }, {
