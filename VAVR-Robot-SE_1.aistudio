      }, {
        "text": "\n            \u003cbutton onClick\u003d{stopSimulation} className\u003d\"flex items-center justify-center gap-2 bg-yellow"
      }, {
        "text": "-600 hover:bg-yellow-700 text-white py-2 px-2 rounded font-bold text-sm transition-"
      }, {
