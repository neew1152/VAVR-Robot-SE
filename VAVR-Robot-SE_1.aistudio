      }, {
        "text": "-js\u0027;\nimport { \n  CPU, avrInstruction, \n  AVRTimer, timer0"
      }, {
        "text": "Config, timer1Config, timer2Config, \n  AVRUSART, usart0Config \n}"
      }, {
        "text": " from \u0027avr8js\u0027; \n\nfunction loadHex(source, target) {\n  for (const line of"
      }, {
        "text": " source.split(\u0027\\n\u0027)) {\n    if (line[0] \u003d\u003d\u003d \u0027:\u0027 \u0026\u0026 line.substring(7,"
      }, {
        "text": " 9) \u003d\u003d\u003d \u002700\u0027) {\n      const bytes \u003d parseInt(line.substring(1, 3"
      }, {
        "text": "), 16);\n      const addr \u003d parseInt(line.substring(3, 7), 16"
      }, {
        "text": ");\n      for (let i \u003d 0; i \u003c bytes; i++) {\n        target[addr +"
      }, {
        "text": " i] \u003d parseInt(line.substring(9 + i * 2, 11 + i * 2"
      }, {
        "text": "), 16);\n      }\n    }\n  }\n}\n\nconst getPinState \u003d (cpu, pin"
      }, {
        "text": ") \u003d\u003e {\n  let portAddr, bit;\n  if (pin \u003e\u003d 0 \u0026\u0026 pin \u003c\u003d 7"
      }, {
        "text": ") {\n    portAddr \u003d 0x2B; bit \u003d pin;\n  } else if (pin"
      }, {
        "text": " \u003e\u003d 8 \u0026\u0026 pin \u003c\u003d 13) {\n    portAddr \u003d 0x25; bit \u003d"
      }, {
        "text": " pin - 8;\n  } else if (pin \u003e\u003d 14 \u0026\u0026 pin \u003c\u003d 19) {"
      }, {
        "text": "\n    portAddr \u003d 0x28; bit \u003d pin - 14;\n  } else {"
      }, {
        "text": " return false; }\n  return (cpu.data[portAddr] \u0026 (1 \u003c\u003c bit)) !\u003d\u003d 0"
      }, {
        "text": ";\n};\n\n// Generates a random ID for new custom parts\nconst generateId \u003d () \u003d\u003e Math.random().toString(36)."
      }, {
        "text": "substr(2, 9);\n\nconst DEFAULT_CONFIG \u003d {\n  leftWidth: 45,\n"
      }, {
        "text": "  editorHeight: 60,\n  canvasHeight: 65,\n  robotX: 2"
      }, {
        "text": "00,\n  robotY: 200,\n  robotAngle: 0,\n  baud"
      }, {
        "text": "Rate: \"9600\",\n  robotBuild: {\n    chassisW: 50,"
      }, {
        "text": "\n    chassisH: 30,\n    parts:[\n      { id: generateId(), type: \u0027wheel\u0027, name"
