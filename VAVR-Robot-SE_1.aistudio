      }, {
        "text": "\n            /\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n\n        {/* TERMINAL UI UPGRADE */}\n        \u003cdiv className\u003d\"h"
      }, {
        "text": "-56 bg-neutral-950 rounded-lg border border-neutral-700 flex flex-col overflow"
      }, {
        "text": "-hidden\"\u003e\n           \u003cdiv className\u003d\"bg-neutral-900 p-2 text-sm font-bold text-gray"
      }, {
        "text": "-300 flex items-center gap-2 border-b border-neutral-700\"\u003e"
      }, {
        "text": "\n            \u003cMonitor size\u003d{16}/\u003e Serial Monitor\n          \u003c/div\u003e\n          \u003cdiv className\u003d\"flex-grow p-2"
      }, {
