      "parts": [{
        "text": "You"
      }, {
        "text": "\u0027ve hit on a core principle of true customization! The robot\u0027s chassis size"
      }, {
        "text": " dictates everything about its physics – its turning radius, its acceleration, how quickly it tips over. Allowing users to directly adjust the chassis dimensions (Width and Height) makes your simulator infinitely more flexible.\n\nHere\u0027s the update to enable Chassis"
      }, {
        "text": " Size customization:\n\n### The Chassis Resizer Update\n\nOpen `src/App.jsx`, delete everything, and paste this update:\n\n```jsx\nimport React, { useState, useRef, useEffect } from \u0027react\u0027;\nimport Editor"
      }, {
        "text": " from \u0027@monaco-editor/react\u0027;\nimport { Play, Square, RotateCcw, Monitor, Settings, Terminal, Crosshair, GripVertical, GripHorizontal, Download, Upload, RefreshCcw, FileUp, ImagePlus, Trash"
      }, {
        "text": "2, Wrench, PlusCircle, X } from \u0027lucide-react\u0027;\nimport Matter from \u0027matter-js\u0027;\nimport { \n  CPU, avrInstruction, \n  AVRTimer, timer0Config, timer1"
      }, {
        "text": "Config, timer2Config, \n  AVRUSART, usart0Config \n} from \u0027avr8js\u0027; \n\nfunction loadHex(source, target) {\n  for (const line of source.split(\u0027\\"
      }, {
        "text": "n\u0027)) {\n    if (line[0] \u003d\u003d\u003d \u0027:\u0027 \u0026\u0026 line.substring(7, 9) \u003d\u003d\u003d \u002700\u0027) {\n      const bytes \u003d parseInt(line.substring(1, 3), 16"
      }, {
        "text": ");\n      const addr \u003d parseInt(line.substring(3, 7), 16);\n      for (let i \u003d 0; i \u003c bytes; i++) {\n        target[addr + i] \u003d parseInt"
      }, {
        "text": "(line.substring(9 + i * 2, 11 + i * 2), 16);\n      }\n    }\n  }\n}\n\nconst getPinState \u003d (cpu, pin) \u003d\u003e"
      }, {
        "text": " {\n  let portAddr, bit;\n  if (pin \u003e\u003d 0 \u0026\u0026 pin \u003c\u003d 7) { portAddr \u003d 0x2B; bit \u003d pin; } \n  else if (pin \u003e\u003d 8"
      }, {
        "text": " \u0026\u0026 pin \u003c\u003d 13) { portAddr \u003d 0x25; bit \u003d pin - 8; } \n  else if (pin \u003e\u003d 14 \u0026\u0026 pin \u003c\u003d 19) { portAddr \u003d "
      }, {
        "text": "0x28; bit \u003d pin - 14; } \n  else { return false; }\n  return (cpu.data[portAddr] \u0026 (1 \u003c\u003c bit)) !\u003d\u003d 0;\n};\n\nconst"
      }, {
        "text": " generateId \u003d () \u003d\u003e Math.random().toString(36).substr(2, 9);\n\nconst TYPE_TAGS \u003d {\n  dc_motor: \u0027DC MOTOR\u0027,\n  imu: \u0027IMU\u0027,\n"
      }, {
        "text": "  ir: \u0027IR SENSOR\u0027,\n  servo: \u0027SERVO\u0027,\n  sonar: \u0027SONAR\u0027\n};\n\nconst DEFAULT_CONFIG \u003d {\n  leftWidth: 45,\n  editorHeight: "
      }, {
        "text": "60,\n  canvasHeight: 65,\n  robotX: 200,\n  robotY: 200,\n  robotAngle: 0,\n  baudRate: \"96"
      }, {
        "text": "00\",\n  robotBuild: {\n    chassisW: 50, // Default Chassis Width\n    chassisH: 30, // Default Chassis Height\n    parts:[\n      { id: generateId"
