        "text": "_LEFT, HIGH);\n  digitalWrite(MOTOR_RIGHT, LOW);\n  delay(1000"
      }, {
        "text": ");\n}`;\n\nfunction App() {\n  const initConfig \u003d getConfig();\n  \n  const"
