utral-900 border border-gray-200 dark:border-transparent p-2 rounded overflow-y-auto relative\"\u003e\n                 \u003cdiv className\u003d\"flex justify-between items-center mb-2\"\u003e\n                    \u003cp className\u003d\"text-gray-500\"\u003e// DYNAMIC COMPONENTS\u003c/p\u003e\n                    \u003cdiv className\u003d\"flex gap-1\"\u003e\n                      \u003cbutton onClick\u003d{() \u003d\u003e addPart(\u0027wheel\u0027)} className\u003d\"flex items-center gap-1 bg-blue-100 hover:bg-blue-200 text-blue-700 dark:bg-blue-900/50 dark:hover:bg-blue-800 dark:text-blue-300 px-1 py-0.5 rounded transition-colors text-[9px]\"\u003e\n                         \u003cPlusCircle size\u003d{10}/\u003e Motor\n                      \u003c/button\u003e\n                      \u003cbutton onClick\u003d{() \u003d\u003e addPart(\u0027sonar\u0027)} className\u003d\"flex items-center gap-1 bg-red-100 hover:bg-red-200 text-red-700 dark:bg-red-900/50 dark:hover:bg-red-800 dark:text-red-300 px-1 py-0.5 rounded transition-colors text-[9px]\"\u003e\n                         \u003cPlusCircle size\u003d{10}/\u003e Sonar\n                      \u003c/button\u003e\n                    \u003c/div\u003e\n                 \u003c/div\u003e\n                 \n                 \u003cdiv className\u003d\"flex flex-col gap-2\"\u003e\n                    {robotBuild.parts.map(part \u003d\u003e (\n                       \u003cdiv key\u003d{part.id} className\u003d\"flex flex-col gap-1 border-b border-gray-200 dark:border-neutral-800 pb-2 relative group\"\u003e\n                          \n                          \u003cbutton onClick\u003d{() \u003d\u003e removePart(part.id)} className\u003d\"absolute top-0 right-0 text-gray-400 hover:text-red-500 transition-colors opacity-50 group-hover:opacity-100\"\u003e\n                             \u003cX size\u003d{12}/\u003e\n                          \u003c/button\u003e\n\n                          \u003cdiv className\u003d\"flex items-center text-gray-700 dark:text-gray-300 pr-4\"\u003e\n                            \u003cspan id\u003d{`pin-ui-${part.id}`} className\u003d\"transition-colors duration-75\"\u003e● {part.name}\u003c/span\u003e\n                          \u003c/div\u003e\n\n                          \u003cdiv className\u003d\"flex gap-2 mt-1\"\u003e\n                            {part.type \u003d\u003d\u003d \u0027wheel\u0027 \u0026\u0026 (\n                               \u003cdiv className\u003d\"flex items-center gap-1\"\u003e\n                                 \u003cspan className\u003d\"text-[10px] text-gray-500\"\u003ePin:\u003c/span\u003e\n                                 \u003cselect value\u003d{part.pin} onChange\u003d{(e) \u003d\u003e updatePart(part.id, \u0027pin\u0027, e.target.value)} className\u003d\"bg-white dark:bg-neutral-950 text-blue-600 dark:text-blue-400 border border-gray-300 dark:border-neutral-700 rounded w-10 outline-none text-center\"\u003e\n                                   {renderPinOptions()}\n                                 \u003c/select\u003e\n                               \u003c/div\u003e\n                            )}\n                            {part.type \u003d\u003d\u003d \u0027sonar\u0027 \u0026\u0026 (\n                               \u003c\u003e\n                               \u003cdiv className\u003d\"flex items-center gap-1\"\u003e\n                                 \u003cspan className\u003d\"text-[10px] text-gray-500\"\u003eTrig:\u003c/span\u003e\n                                 \u003cselect value\u003d{part.pinTrig} onChange\u003d{(e) \u003d\u003e updatePart(part.id, \u0027pinTrig\u0027, e.target.value)} className\u003d\"bg-white dark:bg-neutral-950 text-red-600 dark:text-red-400 border border-gray-300 dark:border-neutral-700 rounded w-10 outline-none text-center\"\u003e\n                                   {renderPinOptions()}\n                                 \u003c/select\u003e\n                               \u003c/div\u003e\n                               \u003cdiv className\u003d\"flex items-center gap-1\"\u003e\n                                 \u003cspan className\u003d\"text-[10px] text-gray-500\"\u003eEcho:\u003c/span\u003e\n                                 \u003cselect value\u003d{part.pinEcho} onChange\u003d{(e) \u003d\u003e updatePart(part.id, \u0027pinEcho\u0027, e.target.value)} className\u003d\"bg-white dark:bg-neutral-950 text-red-600 dark:text-red-400 border border-gray-300 dark:border-neutral-700 rounded w-10 outline-none text-center\"\u003e\n                                   {renderPinOptions()}\n                                 \u003c/select\u003e\n                               \u003c/div\u003e\n                               \u003c/\u003e\n                            )}\n                          \u003c/div\u003e\n                          \n                          \u003cdiv className\u003d\"flex gap-2 text-[10px] text-gray-500 mt-1\"\u003e\n                             \u003cdiv className\u003d\"flex items-center gap-1 w-1/2\"\u003e\n                               \u003cspan\u003eOffset X:\u003c/span\u003e\n                               \u003cinput type\u003d\"number\" value\u003d{part.offsetX} onChange\u003d{(e) \u003d\u003e updatePart(part.id, \u0027offsetX\u0027, e.target.value)} className\u003d\"w-full bg-white dark:bg-neutral-950 border border-gray-300 dark:border-neutral-700 rounded px-1 outline-none focus:border-blue-500\" /\u003e\n                             \u003c/div\u003e\n                             \u003cdiv className\u003d\"flex items-center gap-1 w-1/2\"\u003e\n                               \u003cspan\u003eOffset Y:\u003c/span\u003e\n                               \u003cinput type\u003d\"number\" value\u003d{part.offsetY} onChange\u003d{(e) \u003d\u003e updatePart(part.id, \u0027offsetY\u0027, e.target.value)} className\u003d\"w-full bg-white dark:bg-neutral-950 border border-gray-300 dark:border-neutral-700 rounded px-1 outline-none focus:border-blue-500\" /\u003e\n                             \u003c/div\u003e\n                          \u003c/div\u003e\n                       \u003c/div\u003e\n                    ))}\n                    {robotBuild.parts.length \u003d\u003d\u003d 0 \u0026\u0026 (\n                      \u003cdiv className\u003d\"text-center text-gray-400 italic mt-4 border border-dashed border-gray-300 dark:border-gray-700 p-2 rounded\"\u003eEmpty Chassis\u003c/div\u003e\n                    )}\n                 \u003c/div\u003e\n               \u003c/div\u003e\n\n               {/* TELEMETRY \u0026 POSE */}\n               \u003cdiv className\u003d\"flex-[2] bg-gray-50 dark:bg-neutral-900 border border-gray-200 dark:border-transparent p-2 rounded flex flex-col gap-1\"\u003e\n                 \u003cdiv className\u003d\"text-[10px] font-mono font-bold text-gray-500 flex items-center gap-1 border-b border-gray-200 dark:border-neutral-800 pb-1\"\u003e\n                    \u003cCrosshair size\u003d{12}/\u003e ROBOT POSITION\n                 \u003c/div\u003e\n                 \n                 \u003cdiv className\u003d\"flex gap-4 h-full pt-1\"\u003e\n                   \u003cdiv className\u003d\"flex-1 flex flex-col justify-center text-xs text-gray-600 dark:text-gray-400 font-mono border-r border-gray-300 dark:border-neutral-700 pr-4\"\u003e\n                     \u003cdiv className\u003d\"text-[10px] text-green-600 dark:text-green-500 font-bold mb-1 tracking-widest\"\u003eSYS_TELEMETRY\u003c/div\u003e\n                     \u003cdiv className\u003d\"flex justify-between\"\u003e\u003cspan\u003ePORTB:\u003c/span\u003e \u003cspan id\u003d\"hud-portb\"\u003e00000000\u003c/span\u003e\u003c/div\u003e\n                     \u003cdiv className\u003d\"flex justify-between mt-1 pt-1 border-t border-gray-200 dark:border-neutral-800 text-green-700 dark:text-green-400\"\u003e\u003cspan\u003eCUR_X:\u003c/span\u003e \u003cspan id\u003d\"hud-x\"\u003e200\u003c/span\u003e\u003c/div\u003e\n                     \u003cdiv className\u003d\"flex justify-between text-green-700 dark:text-green-400\"\u003e\u003cspan\u003eCUR_Y:\u003c/span\u003e \u003cspan id\u003d\"hud-y\"\u003e200\u003c/span\u003e\u003c/div\u003e\n                     \u003cdiv className\u003d\"flex justify-between text-green-700 dark:text-green-400\"\u003e\u003cspan\u003eANGLE:\u003c/span\u003e \u003cspan\u003e\u003cspan id\u003d\"hud-angle\"\u003e0.00\u003c/span\u003e°\u003c/span\u003e\u003c/div\u003e\n                   \u003c/div\u003e\n\n                   \u003cdiv className\u003d\"flex-[1.5] flex flex-col justify-center\"\u003e\n                     \u003cdiv className\u003d\"text-[10px] text-gray-500 font-bold mb-1 tracking-widest\"\u003eMANUAL POSE\u003c/div\u003e\n                     \u003cdiv className\u003d\"grid grid-cols-2 gap-1 text-xs text-gray-600 dark:text-gray-400 font-mono\"\u003e\n                        \u003cdiv className\u003d\"flex items-center gap-1\"\u003e\n                           \u003cspan\u003eX:\u003c/span\u003e\n                           \u003cinput id\u003d\"input-x\" type\u003d\"number\" className\u003d\"w-full bg-white dark:bg-neutral-950 border border-gray-300 dark:border-neutral-700 rounded px-1 text-green-700 dark:text-green-400 focus:outline-none focus:border-green-500\" /\u003e\n                        \u003c/div\u003e\n                        \u003cdiv className\u003d\"flex items-center gap-1\"\u003e\n                           \u003cspan\u003eY:\u003c/span\u003e\n                           \u003cinput id\u003d\"input-y\" type\u003d\"number\" className\u003d\"w-full bg-white dark:bg-neutral-950 border border-gray-300 dark:border-neutral-700 rounded px-1 text-green-700 dark:text-green-400 focus:outline-none focus:border-green-500\" /\u003e\n                        \u003c/div\u003e\n                        \u003cdiv className\u003d\"flex items-center gap-1 col-span-2\"\u003e\n                           \u003cspan\u003eAng:\u003c/span\u003e\n                           \u003cinput id\u003d\"input-angle\" type\u003d\"number\" className\u003d\"w-full bg-white dark:bg-neutral-950 border border-gray-300 dark:border-neutral-700 rounded px-1 text-green-700 dark:text-green-400 focus:outline-none focus:border-green-500\" /\u003e\n                        \u003c/div\u003e\n                     \u003c/div\u003e\n                     \u003cbutton onClick\u003d{applyManualPose} className\u003d\"mt-1 w-full bg-gray-300 dark:bg-neutral-700 hover:bg-gray-400 dark:hover:bg-neutral-600 text-gray-800 dark:text-white text-[10px] font-bold py-1 rounded transition-colors\"\u003e\n                        APPLY TELEPORT\n                     \u003c/button\u003e\n                   \u003c/div\u003e\n                 \u003c/div\u003e\n               \u003c/div\u003e\n            \u003c/div\u003e\n          \u003c/div\u003e\n\n          \u003cdiv className\u003d\"w-1/3 bg-gray-50 dark:bg-neutral-800 rounded-lg border border-gray-300 dark:border-neutral-700 p-2 flex flex-col justify-center gap-2 shadow-sm\"\u003e\n            \u003cbutton onClick\u003d{runSimulationCloud} disabled\u003d{isRunning} className\u003d{`flex items-center justify-center gap-2 py-2 px-2 rounded font-bold text-sm transition-colors ${isRunning ? \u0027bg-gray-300 text-gray-500 dark:bg-gray-700 dark:text-gray-500 cursor-not-allowed\u0027 : \u0027bg-green-600 hover:bg-green-700 text-white\u0027}`}\u003e\n              \u003cPlay size\u003d{16} fill\u003d\"currentColor\" /\u003e RUN (Cloud)\n            \u003c/button\u003e\n            \u003cbutton onClick\u003d{stopSimulation} className\u003d\"flex items-center justify-center gap-2 bg-yellow-600 hover:bg-yellow-700 text-white py-2 px-2 rounded font-bold text-sm transition-colors\"\u003e\n              \u003cSquare size\u003d{16} fill\u003d\"currentColor\" /\u003e STOP\n            \u003c/button\u003e\n            \u003cbutton onClick\u003d{resetSimulation} className\u003d\"flex items-center justify-center gap-2 bg-red-600 hover:bg-red-700 text-white py-2 px-2 rounded font-bold text-sm transition-colors\"\u003e\n              \u003cRotateCcw size\u003d{16} /\u003e RESET\n            \u003c/button\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n  );\n}\n\nexport default App;\n```",
