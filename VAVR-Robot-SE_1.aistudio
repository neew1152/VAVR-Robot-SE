      }, {
        "text": " HEX PARSER ---\nfunction loadHex(source, target) {\n  for (const line of source.split"
      }, {
        "text": "(\u0027\\n\u0027)) {\n    if (line[0] \u003d\u003d\u003d \u0027:\u0027 \u0026\u0026 line.substring(7, 9)"
      }, {
        "text": " \u003d\u003d\u003d \u002700\u0027) {\n      const bytes \u003d parseInt(line.substring(1, 3), 1"
      }, {
        "text": "6);\n      const addr \u003d parseInt(line.substring(3, 7), 16);"
      }, {
        "text": "\n      for (let i \u003d 0; i \u003c bytes; i++) {\n        target[addr + i] \u003d"
      }, {
        "text": " parseInt(line.substring(9 + i * 2, 11 + i * 2), 1"
      }, {
        "text": "6);\n      }\n    }\n  }\n}\n\n// --- DEFAULT CONFIGURATION ---\nconst DEFAULT_CONFIG"
      }, {
        "text": " \u003d {\n  leftWidth: 45,\n  editorHeight: 60,\n  canvasHeight"
      }, {
        "text": ": 65,\n  robotX: 200,\n  robotY: 200"
      }, {
        "text": ",\n  robotAngle: 0 // In radians\n};\n\nconst getConfig \u003d () \u003d\u003e {\n  try {\n    const saved"
      }, {
