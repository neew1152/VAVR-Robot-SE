        "text": "\n    }\n  }\n}\n\n// --- DEFAULT CONFIGURATION ---\nconst DEFAULT_CONFIG \u003d {\n  left"
      }, {
        "text": "Width: 45,\n  editorHeight: 60,\n  canvasHeight: 65,"
      }, {
        "text": "\n  robotX: 200,\n  robotY: 200,\n  robotAngle"
      }, {
        "text": ": 0 \n};\n\nconst getConfig \u003d () \u003d\u003e {\n  try {\n    const saved \u003d localStorage."
