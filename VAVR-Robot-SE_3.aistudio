      }, {
        "text": "\n                              needsDomUpdate \u003d true;\n                          }\n                          decodeLcdByte(data);\n                      }\n                  }"
      }, {
        "text": "\n              }\n          }\n          \n          // Let AVRTWI process the state machine normally so the Arduino code"
      }, {
        "text": " doesn\u0027t freeze\n          if (origTwcrHook) origTwcrHook(value);\n      };"
      }, {
        "text": "\n      // --- END SNIFFER ---\n      \n      setIsRunning(true);\n      isRunningRef.current \u003d true;"
      }, {
        "text": "\n      if (isOffline) setSysLogs(prev \u003d\u003e"
      }, {
