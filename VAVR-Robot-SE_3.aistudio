        "text": "[];\n      let pingLogCount \u003d 0;\n\n      const decodeLcdByte \u003d (byte) \u003d\u003e {\n          const rs \u003d byte \u0026 0x01;\n          const en \u003d (byte \u003e\u003e 2) \u0026 0x01;\n          const data \u003d byte \u0026 0xF0;\n\n          if (lcdLastEn \u003d\u003d\u003d 1 \u0026\u0026 en \u003d\u003d\u003d 0) { // Catch EN falling edge\n              if (!lcd4BitMode) {\n                  if (data \u003d\u003d\u003d 0x20 || data \u003d\u003d\u003d 0x30) {\n                      lcd4BitMode \u003d true;\n                      lcdHighNibble \u003d null;\n                  }\n              } else {\n                  if (lcdHighNibble \u003d\u003d\u003d null) {\n                      lcdHighNibble \u003d data;\n                  } else {\n                      const fullByte \u003d lcdHighNibble | (data \u003e\u003e 4);\n                      lcdHighNibble \u003d null;\n\n                      if (rs \u003d\u003d\u003d 0) { // Command\n                          if (fullByte \u003d\u003d\u003d 0x01) { // Clear display\n                              localLcdLines \u003d [\"                \", \"                \"];\n                              lcdCursorCol \u003d"
      }, {
