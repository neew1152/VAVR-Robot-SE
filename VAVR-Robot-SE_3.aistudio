        "text": "[] \n};\n\nconst getConfig \u003d () \u003d\u003e {\n  try {\n    const saved \u003d localStorage.getItem(\u0027flawless-config\u0027);\n    if (saved) return { ...DEFAULT_CONFIG, ...JSON.parse(saved) };\n  } catch (e) {}\n  return DEFAULT_CONFIG;\n};\n\nconst defaultCode \u003d `#include \u003cWire.h\u003e\n#include \u003cLiquidCrystal_I2C.h\u003e\n\nint MOTOR_LEFT \u003d 9;  \nint MOTOR_RIGHT \u003d 10; \n\n// Setup LCD on Address 0x27\nLiquidCrystal_I2C lcd(0x27, 16, 2);\n\nvoid setup() {\n  Serial.begin(9600);\n  Serial.println(\"System Booting...\");\n\n  // Initialize LCD\n  lcd.init();\n  lcd.backlight();\n  lcd.setCursor(0, 0);\n  lcd.print(\"ROBOT ONLINE\");\n\n  pinMode(MOTOR_LEFT, OUTPUT);\n  pinMode(MOTOR_RIGHT, OUTPUT);\n  Serial.println(\"Robot Ready!\");\n}\n\nvoid loop() {\n  lcd.setCursor(0, 1);\n  lcd.print(\"Driving Forward \");\n  Serial.println(\"Driving Forward...\");\n  digitalWrite(MOTOR_LEFT, HIGH);\n  digitalWrite(MOTOR_RIGHT, HIGH);\n  delay(1000);\n\n  lcd.setCursor(0, 1);\n  lcd.print(\"Stopping        \");\n  Serial.println(\"Stopping...\");\n  digitalWrite(MOTOR_LEFT, LOW);\n  digitalWrite(MOTOR_RIGHT, LOW);\n  delay(500);\n\n  lcd.setCursor(0, 1);\n  lcd.print(\"Turning Right   \");\n  Serial.println(\"Turning Right...\");\n  digitalWrite(MOTOR_LEFT, HIGH);\n  digitalWrite(MOTOR_RIGHT, LOW);\n  delay(1000);\n}`;\n\nconst getSavedCode \u003d () \u003d\u003e {\n  try {\n    const saved \u003d localStorage.getItem(\u0027flawless-code-cache\u0027);\n    if (saved !\u003d\u003d null) return saved;\n  } catch (e) {}\n  return defaultCode;\n};\n\nfunction App() {\n  const initConfig \u003d getConfig();\n  \n  const[code, setCode] \u003d useState(getSavedCode"
