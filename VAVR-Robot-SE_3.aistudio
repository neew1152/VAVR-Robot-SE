      }, {
        "text": ");\n      const addr \u003d parseInt(line.substring(3, 7), 16);\n      for"
      }, {
        "text": " (let i \u003d 0; i \u003c bytes; i++) {\n        target[addr + i] \u003d parseInt"
      }, {
        "text": "(line.substring(9 + i * 2, 11 + i * 2), 16"
      }, {
        "text": ");\n      }\n    }\n  }\n}\n\nconst getPinState \u003d (cpu, pin) \u003d\u003e"
      }, {
        "text": " {\n  let portAddr, bit;\n  if (pin \u003e\u003d 0 \u0026\u0026 pin \u003c\u003d 7) {"
      }, {
        "text": " portAddr \u003d 0x2B; bit \u003d pin; } \n  else if (pin \u003e\u003d 8"
      }, {
        "text": " \u0026\u0026 pin \u003c\u003d 13) { portAddr \u003d 0x25; bit \u003d pin - 8;"
      }, {
        "text": " } \n  else if (pin \u003e\u003d 14 \u0026\u0026 pin \u003c\u003d 19) { portAddr \u003d"
      }, {
        "text": " 0x28; bit \u003d pin - 14; } \n  else { return false; }"
      }, {
        "text": "\n  return (cpu.data[portAddr] \u0026 (1 \u003c\u003c bit)) !\u003d\u003d 0;\n};\n\nconst"
      }, {
        "text": " setExternalPin \u003d (cpu, pin, isHigh) \u003d\u003e {\n  let pinAddr, bit;"
      }, {
        "text": "\n  if (pin \u003e\u003d 0 \u0026\u0026 pin \u003c\u003d 7) { pinAddr \u003d 0x29; bit \u003d"
      }, {
        "text": " pin; }  \n  else if (pin \u003e\u003d 8 \u0026\u0026 pin \u003c\u003d 13) { pinAddr \u003d"
      }, {
        "text": " 0x23; bit \u003d pin - 8; } \n  else if (pin \u003e\u003d 1"
      }, {
        "text": "4 \u0026\u0026 pin \u003c\u003d 19) { pinAddr \u003d 0x26; bit \u003d pin - 1"
      }, {
        "text": "4; } \n  else { return; }\n\n  if (isHigh) {\n    cpu.data"
      }, {
        "text": "[pinAddr] |\u003d (1 \u003c\u003c bit);\n  } else {\n    cpu.data[pinAddr]"
      }, {
        "text": " \u0026\u003d ~(1 \u003c\u003c bit);\n  }\n};\n\nconst generateId \u003d () \u003d\u003e Math.random().toString("
      }, {
        "text": "36).substr(2, 9);\n\nconst getOppositeColor \u003d (hex) \u003d\u003e {"
      }, {
        "text": "\n  if (hex.indexOf(\u0027#\u0027) \u003d\u003d\u003d 0) hex \u003d hex.slice(1);\n  if (hex"
      }, {
