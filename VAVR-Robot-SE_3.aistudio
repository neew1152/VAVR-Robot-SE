      }, {
        "text": "byte);\n      };\n\n      // --- PASSIVE BARE-METAL I2C SNIFFER ---\n      // Instead"
      }, {
        "text": " of relying on AVRTWI\u0027s callbacks, we directly intercept the CPU registers \n      // exactly as the hardware"
      }, {
        "text": " I2C bus behaves.\n      let isLcdOnline \u003d false;\n      let lcdLastEn \u003d 0;\n      let lcd"
      }, {
        "text": "4BitMode \u003d false;\n      let lcdHighNibble \u003d null;\n      let lcdLines \u003d"
      }, {
        "text": "[\"                \", \"                \"];\n      let lcdCursorCol \u003d 0;\n      let lcdCursorRow \u003d 0;"
      }, {
        "text": "\n      let needsDomUpdate \u003d false;\n      let logBuffer \u003d"
      }, {
        "text": "[];\n\n      const origTwcrHook \u003d cpu.writeHooks[0xBC]; // 0xBC is TWCR\n      let sniffedAddress \u003d null;"
      }, {
        "text": "\n\n      const decodeLcdByte \u003d (byte) \u003d\u003e {\n          const rs \u003d byte \u0026 0x01;\n          const en \u003d"
      }, {
        "text": " (byte \u003e\u003e 2) \u0026 0x01;\n          const data \u003d byte \u0026 0xF0"
      }, {
        "text": ";\n\n          if (lcdLastEn \u003d\u003d\u003d 1 \u0026\u0026 en \u003d\u003d\u003d 0) { // Catch EN falling edge"
      }, {
        "text": "\n              if (!lcd4BitMode) {\n                  if (data \u003d\u003d\u003d 0x20) { // Specific"
      }, {
        "text": " byte that turns on 4-bit mode\n                      lcd4BitMode \u003d true;\n                      lcdHighNibble \u003d"
      }, {
        "text": " null;\n                  }\n              } else {\n                  if (lcdHighNibble \u003d\u003d\u003d null) {"
      }, {
        "text": "\n                      lcdHighNibble \u003d data;\n                  } else {\n                      const fullByte \u003d lcdHighNibble | (data \u003e\u003e 4);"
      }, {
        "text": "\n                      lcdHighNibble \u003d null;\n\n                      if (rs \u003d\u003d\u003d 0) { // Command\n                          if (full"
      }, {
        "text": "Byte \u003d\u003d\u003d 0x01) { // Clear display\n                              lcdLines \u003d [\"                \", \"                \"];"
      }, {
        "text": "\n                              lcdCursorCol \u003d 0; lcdCursorRow \u003d 0;\n                          } else if (fullByte \u003d\u003d\u003d"
      }, {
        "text": " 0x02) { // Return Home\n                              lcdCursorCol \u003d 0; lcdCursorRow \u003d"
      }, {
        "text": " 0;\n                          } else if ((fullByte \u0026 0x80) \u003d\u003d\u003d 0x80)"
      }, {
        "text": " { // Set DDRAM Address\n                              const addr \u003d fullByte \u0026 0x7F;\n                              lcdCursor"
      }, {
        "text": "Row \u003d addr \u003e\u003d 0x40 ? 1 : 0;\n                              lcdCursorCol \u003d addr \u003e\u003d"
      }, {
        "text": " 0x40 ? addr - 0x40 : addr;\n                          }\n                      } else {"
      }, {
        "text": " // ASCII Character\n                          if (lcdCursorCol \u003c 16) {\n                              let char \u003d String.fromCharCode"
      }, {
        "text": "(fullByte);\n                              if (fullByte \u003c 0x20) char \u003d \u0027 \u0027;"
      }, {
        "text": " \n                              let line \u003d lcdLines[lcdCursorRow];\n                              lcdLines[lcdCursorRow] \u003d line.substring("
      }, {
        "text": "0, lcdCursorCol) + char + line.substring(lcdCursorCol + 1);\n                              lcdCursor"
      }, {
        "text": "Col++;\n                          }\n                      }\n                      needsDomUpdate \u003d true;\n                  }\n              }"
      }, {
        "text": "\n          }\n          lcdLastEn \u003d en;\n      };\n\n      cpu.writeHooks[0xBC] \u003d (value) \u003d\u003e {"
      }, {
        "text": "\n          const TWINT \u003d value \u0026 0x80;\n          const TWSTA \u003d value \u0026 0x2"
      }, {
        "text": "0;\n          const TWSTO \u003d value \u0026 0x10;\n          const TWEN  \u003d value"
      }, {
        "text": " \u0026 0x04;\n\n          if (TWEN \u0026\u0026 TWINT) {\n              if (TWSTA) {"
      }, {
        "text": "\n                  sniffedAddress \u003d null; // Beginning of a START condition\n              } else if (TWSTO)"
      }, {
