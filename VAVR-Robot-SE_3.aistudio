      }, {
        "text": "\n      \n      const program \u003d new Uint16Array(16384);\n      loadHex(hexData, new"
      }, {
        "text": " Uint8Array(program.buffer));\n      \n      const cpu \u003d new CPU(program);\n      const timer"
      }, {
        "text": "0 \u003d new AVRTimer(cpu, timer0Config);\n      const timer1 \u003d new AVRTimer(cpu,"
      }, {
        "text": " timer1Config);\n      const timer2 \u003d new AVRTimer(cpu, timer2Config);\n      const us"
      }, {
        "text": "art \u003d new AVRUSART(cpu, usart0Config, 16e6);\n      const adc \u003d"
      }, {
        "text": " new AVRADC(cpu, adcConfig);\n      \n      // Let AVRTWI handle the complex interrupt state machines\n      const twi"
      }, {
