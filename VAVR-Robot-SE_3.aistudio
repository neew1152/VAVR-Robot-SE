        "text": "), 16);\n  \n  if (Math.abs(r - 128) \u003c"
      }, {
        "text": " 30 \u0026\u0026 Math.abs(g - 128) \u003c 30 \u0026\u0026 Math.abs(b"
      }, {
        "text": " - 128) \u003c 30) {\n    return r \u003e 128 ? \u0027#00000"
      }, {
        "text": "0\u0027 : \u0027#ffffff\u0027;\n  }\n  \n  return `#${r.toString(16).padStart"
      }, {
        "text": "(2, \u00270\u0027)}${g.toString(16).padStart(2, \u00270\u0027)}${b."
      }, {
        "text": "toString(16).padStart(2, \u00270\u0027)}`;\n};\n\nconst TYPE_TAGS \u003d {"
      }, {
        "text": "\n  dc_motor: \u0027DC MOTOR\u0027,\n  imu: \u0027IMU\u0027,\n  ir_sensor: \u0027"
      }, {
        "text": "IR SENSOR\u0027,\n  sonar: \u0027SONAR\u0027,\n  grabber: \u0027GRABBER\u0027,"
      }, {
        "text": "\n  oled128x64: \u0027128x64 OLED\u0027,\n  lcd16x2"
      }, {
        "text": ": \u002716x2 LCD\u0027\n};\n\nconst DEFAULT_COLORS \u003d {\n  chassis: \u0027#3"
      }, {
        "text": "b82f6\u0027,\n  dc_motor: \u0027#000000\u0027,\n  sonar:"
