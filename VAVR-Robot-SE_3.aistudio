      }, {
        "text": "  AVRUSART, usart0Config,\n  AVRADC, adcConfig,\n  AVRTWI"
      }, {
        "text": ", twiConfig \n} from \u0027avr8js\u0027; \n\nfunction loadHex(source, target) {"
      }, {
        "text": "\n  for (const line of source.split(\u0027\\n\u0027)) {\n    if (line[0] \u003d\u003d\u003d \u0027:\u0027"
      }, {
