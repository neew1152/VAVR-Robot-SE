      }, {
        "text": "\n      \n      const hudPortb \u003d document.getElementById(\u0027hud-portb\u0027);\n      const serialEl \u003d document"
      }, {
        "text": ".getElementById(\u0027serial-console\u0027);\n\n      const sonars \u003d buildRef.current.parts.filter(p \u003d\u003e"
      }, {
        "text": " p.type \u003d\u003d\u003d \u0027sonar\u0027);\n      const sonarDefs \u003d sonars.map(p \u003d\u003e {\n         let"
      }, {
        "text": " portAddr, bit;\n         if (p.pinTrig \u003e\u003d 0 \u0026\u0026 p.pinTrig \u003c\u003d"
      }, {
        "text": " 7) { portAddr \u003d 0x2B; bit \u003d p.pinTrig; }"
      }, {
        "text": " \n         else if (p.pinTrig \u003e\u003d 8 \u0026\u0026 p.pinTrig \u003c\u003d 13) {"
      }, {
