      }, {
        "text": "4} fill\u003d\"currentColor\" /\u003e STOP\n            \u003c/button\u003e\n            \u003cbutton onClick\u003d{resetSimulation} className\u003d\""
      }, {
        "text": "flex items-center justify-center gap-2 bg-red-600 hover:bg-red-7"
      }, {
        "text": "00 text-white py-1.5 px-2 rounded font-bold text-[13px] transition"
